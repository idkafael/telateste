# Vercel → projeto com Root Directory = syncpay-next → Environment Variables
# A landing está em public/; mesma URL serve HTML e /api/* (envs abaixo só no servidor — isso já funciona).

DATABASE_URL=postgresql://USUARIO:SENHA@HOST/NOME_DO_BANCO?sslmode=require

# Mesma URL pública deste deploy (ex.: https://telateste-phi.vercel.app ou o .vercel.app gerado)
APP_BASE_URL=https://telateste-phi.vercel.app
FRONTEND_ORIGIN=https://telateste-phi.vercel.app

LOG_LEVEL=info
SYNCPAY_MOCK=false

SYNCPAY_BASE_URL=https://api.syncpayments.com.br
SYNCPAY_CLIENT_ID=seu_client_id_uuid
SYNCPAY_CLIENT_SECRET=seu_client_secret_uuid

SYNCPAY_DEFAULT_CLIENT_CPF=52998224725
SYNCPAY_DEFAULT_CLIENT_PHONE=11999999999
# SYNCPAY_WEBHOOK_TOKEN=
# SYNCPAY_WEBHOOK_SIGNATURE_SECRET=

# Domínio customizado: use o mesmo https nas duas variáveis acima.
# Live Server + npm run dev na pasta pai: mantenha FRONTEND_ORIGIN=http://127.0.0.1:5500 e meta/API em script.js para localhost:3000.
