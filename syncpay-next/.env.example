# Copie para .env na pasta syncpay-next e ajuste os valores.
# Gerar pagamento em localhost: SYNCPAY_MOCK=true + npm run dev

DATABASE_URL="file:./dev.db"

# URL pública do backend Next (webhook aponta para APP_BASE_URL/api/webhooks/syncpay)
APP_BASE_URL="http://localhost:3000"
LOG_LEVEL="info"

# Origem da página estática (Live Server, etc.) — precisa bater com a URL do navegador
FRONTEND_ORIGIN="http://127.0.0.1:5500"

# --- Modo local sem SyncPay real: cobrança e consulta mockadas no banco ---
SYNCPAY_MOCK=true

# Com SYNCPAY_MOCK=false — doc: https://syncpay.apidog.io/
# SYNCPAY_BASE_URL="https://api.synchpay.com"
# SYNCPAY_CLIENT_ID="YOUR_CLIENT_ID"
# SYNCPAY_CLIENT_SECRET="YOUR_CLIENT_SECRET"
# Se o front não enviar CPF/telefone, use fallback só em dev:
# SYNCPAY_DEFAULT_CLIENT_CPF="52998224725"
# SYNCPAY_DEFAULT_CLIENT_PHONE="11999999999"

# Opcional em produção: se a SyncPay enviar Authorization no webhook
# SYNCPAY_WEBHOOK_TOKEN="seu_token_webhook"

# Opcional: assinatura HMAC (confirmar na doc)
# SYNCPAY_WEBHOOK_SIGNATURE_SECRET=""
